# FarmWise Environment Variables - TEMPLATE
# Copy this file to .env and fill in actual values
# NEVER commit .env to version control

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development

# ============================================
# FRONTEND
# ============================================
VITE_API_BASE_URL=http://localhost:3000/api/v1

# ============================================
# BACKEND
# ============================================
PORT=3000
BACKEND_URL=http://localhost:3000

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# ============================================
# JWT / AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# OTP CONFIGURATION
# ============================================
OTP_EXPIRY_MINUTES=15
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6

# ============================================
# EMAIL SERVICE
# ============================================
# Email configuration for OTP and password reset
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=farmwise@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_FROM=noreply@farmwise.com

# ============================================
# SMS SERVICE (HUBTEL)
# ============================================
HUBTEL_API_KEY=your_hubtel_api_key
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_SMS_FROM=FarmWise

# ============================================
# FILE STORAGE
# ============================================
# Configuration for image/file uploads
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# For cloud storage:
# AWS_S3_BUCKET=your_bucket
# AWS_REGION=your_region
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# ============================================
# AI SERVICE
# ============================================
# For future AI-assisted recommendations and image analysis
# AI_SERVICE_URL=https://api.aiservice.com
# AI_SERVICE_KEY=your_ai_service_key

# ============================================
# PUSH NOTIFICATIONS
# ============================================
# For future push notification service
# FCM_SERVER_KEY=your_fcm_server_key

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
