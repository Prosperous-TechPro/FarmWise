<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/page_padding"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Record harvest" android:textColor="@color/black" android:textSize="28sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="A harvest is recorded separately from any future sale." android:textColor="@color/text_secondary"/><EditText android:id="@+id/harvest_cycle_id_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:hint="Crop cycle ID"/><EditText android:id="@+id/harvest_quantity_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Quantity" android:inputType="numberDecimal"/><EditText android:id="@+id/harvest_unit_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Unit: KG, BAG, PIECE"/><EditText android:id="@+id/harvest_date_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Harvest date: YYYY-MM-DD"/><EditText android:id="@+id/harvest_grade_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Grade (optional)"/><EditText android:id="@+id/harvest_damage_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Damage percentage (optional)" android:inputType="numberDecimal"/><EditText android:id="@+id/harvest_notes_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Notes" android:inputType="textMultiLine"/><com.google.android.