<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/page_padding"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Add sale" android:textColor="@color/black" android:textSize="28sp" android:textStyle="bold"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Sales are recorded separately from harvests, payments, and expenses." android:textColor="@color/text_secondary"/><EditText android:id="@+id/sale_number_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:hint="Sale number"/><EditText android:id="@+id/sale_total_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Total sale amount" android:inputType="numberDecimal"/><EditText android:id="@+id/sale_currency_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Currency: GHS, USD, EUR"/><EditText android:id="@+id/sale_payment_method_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Payment method: CASH, CARD, MOBILE_MONEY"/><EditText android:id="@+id/sale_status_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Status: DRAFT, CONFIRMED, PAID"/><EditText android:id="@+id/sale_buyer_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Buyer/customer name (optional)"/><EditText android:id="@+id/sale_date_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Sale date: YYYY-MM-DD"/><EditText android:id="@+id/sale_notes_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Notes" android:inputType="textMultiLine"/><com.google.android.material.button.MaterialButton android:id="@+id/save_sale_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Save sale"/><TextView android:id="@+id/add_sale_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/text_secondary"/></LinearLayout></ScrollView>
