<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/page_padding">
    <TextView android:id="@+id/verification_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Verify your account" android:textColor="@color/black" android:textSize="26sp" android:textStyle="bold" />
    <TextView android:id="@+id/verification_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Enter the code sent by SMS or email. Never share it with anyone." android:textColor="@color/text_secondary" />
    <EditText android:id="@+id/user_id_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:hint="User ID" android:inputType="text" />
    <EditText android:id="@+id/code_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:hint="Verification code" android:inputType="number" android:maxLength="6" />
    <com.google.android.material.button.MaterialButton android:id="@+id/verify_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Verify" />
    <com.google.android.material.button.MaterialButton android:id="@+id/resend_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Resend code" />
    <TextView android:id="@+id/verification_state" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/text_secondary" />
</LinearLayout>
