{
  "name": "farmwise-backend",
  "version": "0.0.1",
  "description": "FarmWise - Agricultural Management Platform (Backend)",
  "type": "module",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test src/**/*.test.js",
    "lint": "eslint src --ext .js",
    "format": "prettier --write \"src/**/*.js\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.1.0"
  },
  "devDependencies": {
    "eslint": "^8.42.0",
    "prettier": "^2.8.8"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
