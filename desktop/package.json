{
  "name": "farmwise-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop wrapper for the FarmWise web application",
  "author": "FarmWise",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "31.7.4",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.farmwise.desktop",
    "productName": "FarmWise",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "FarmWise-${version}-portable.exe"
    }
  }
}
